@model IEnumerable<Modelo.Docente.CursoProfessor>

@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>VerificarUltimosRegistros</title>
</head>
<body>
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.CursoID)
                </th>
                <th>
                    Nome do Curso
                </th>
      
                <th>
                    @Html.DisplayNameFor(model => model.ProfessorID)
                </th>

                <th>
                    Nome do Professor
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.CursoID)
                    </td>

                    <!-- Trazer nome do curso -->
                    <td>
                        @item.Curso.Nome
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.ProfessorID)
                    </td>
                    
                    <!-- Trazer nome do professor -->
                    <td>
                        @item.Professor.Nome
                    </td>

                </tr>
            }
        </tbody>
    </table>
    <p>
        <a asp-action="AdicionarProfessor">Voltar para Adicionar Professor</a>
    </p>

</body>
</html>