@model Modelo.Cadastros.Departamento

@{
	ViewData["Title"] = "Details";
	Layout = "_LayoutIES";
}

@section Styles {
	<environment include="Development">
		<link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" />
	</environment>
	<environment exclude="Development">
		asp-fallback-test-class="sr-only"
		asp-fallback-test-property="position"
		asp-fallback-test-value="absolute" />
	</environment>
}

<div class="card-block">
	<div class="card-header	text-white	bg-secondary h1">
		Exibindo detalhes do departamento
	</div>

	@{
		await Html.RenderPartialAsync("~/Views/Departamento/_PartialDetailsContentCard.cshtml", Model);	
	}

	<div class="card-footer	bg-info	text-center	text-white">
		<a asp-action="Index" class="btn btn-light">Retornar à lista</a> |
		<a asp-action="Edit" class="btn	btn-warning" asp-route-id="@Model.DepartamentoID">Alterar departamento</a>
	</div>

</div>