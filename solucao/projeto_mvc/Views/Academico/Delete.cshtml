@model Modelo.Discente.Academico

@{
    Layout = "_LayoutIES";
}

@section Styles {
    <environment exclude="Development">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/font-awesome.min.css"
              asp-fallback-test-class="sr-only" asp-fallback-test-property="position" asp-fallback-test-value="absolute" />
    </environment>
}

<div class="card-block">
    <div class="card bg-secondary h1">Deletando Acadêmico</div>
    @{
        await Html.RenderPartialAsync("~/Views/Academico/_PartialDetailsContentCard.cshtml", Model);
    }

    <div class="card-footer bg-info text-center text-white">
        <form asp-action="Delete">
            <input type="hidden" asp-for="AcademicoID" />
            <input type="submit" value="Deletar acadêmico" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-info">Retornar à lista</a>
        </form>
    </div>
</div>



@section ScriptPage {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}