@model IEnumerable<capitulo01.Models.Instituicao>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Criar nova instituição</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Endereco)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(model => item.Endereco)
            </td>
            <td>
                    <button><a asp-action="Edit" asp-route-id="@item.InstituicaoID">Editar</a></button> |
                    <button><a asp-action="Details" asp-route-id="@item.InstituicaoID">Exibir detalhes</a></button> |
                    <button><a asp-action="Delete" asp-route-id="@item.InstituicaoID">Deletar</a></button>
            </td>
        </tr>
}
    </tbody>
</table>
